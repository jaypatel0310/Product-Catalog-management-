@model List<Practical6.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Products</title>
    <style>
        body {
            font-family: Arial;
            margin: 30px;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 80%;
            margin: auto;
            border-collapse: collapse;
        }

        th {
            background-color: lightgray;
        }

        th, td {
            padding: 10px;
            text-align: center;
            border: 1px solid black;
        }

        a {
            color: blue;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <h2>Product List</h2>

    <table border="1" cellpadding="10">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Action</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Category</td>
                <td>
                    @Html.ActionLink(
                        "More Details",
                        "Details",
                        "Products",
                        new { id = product.ProductId },
                        null
                    )
                </td>
            </tr>
        }

    </table>

</body>
</html>